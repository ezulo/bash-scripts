#!/usr/bin/env bash

# dmenu wrapper with AwesomeWM powerarrow theme colors

# Colors from ~/.config/awesome/themes/powerarrow/theme.lua
NB="#222222"  # normal background (bg_normal)
NF="#FEFEFE"  # normal foreground (fg_normal)
SB="#32D6FF"  # selected background (fg_focus - cyan accent)
SF="#222222"  # selected foreground (dark text on cyan)
FONT="JetBrains Mono:size=10"

DMENU_ARGS=(-nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF" -fn "$FONT" "$@")

if [ -p /dev/stdin ]; then
    exec dmenu "${DMENU_ARGS[@]}"
else
    exec dmenu_run "${DMENU_ARGS[@]}"
fi
